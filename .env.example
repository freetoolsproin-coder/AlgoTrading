# Copy this file to .env and fill in your values. .env is git-ignored; this template is not.
# Environment variables with the same names take precedence over .env.

# Upstox app (developer console). Needed for the daily login: python -m src.broker.auth
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=https://api.upstox.com/v2/login/

# Optional: an access token set here is used instead of upstox_token.json (written by the login above).
UPSTOX_ACCESS_TOKEN=

# Optional: Telegram alerts ([NOTIFY] in config/scanner.ini decides which alert types are sent)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# LIVE ORDERS (leave empty unless you really want real orders). Live trading needs ALL of:
#   [EXECUTION] mode = live in config/scanner.ini, this exact line, and `python -m src.execution.live_gate --arm` each day.
# LIVE_TRADING_CONFIRM=I ACCEPT REAL-MONEY RISK
LIVE_TRADING_CONFIRM=

# Movement service (python -m src.movement), both optional:
#   MOVEMENT_WEBHOOK_URL   every pushed trigger is POSTed here as JSON (n8n, Zapier, Discord bridge, your own bot ...)
#   MOVEMENT_API_TOKEN     if set, changing rules from another computer needs this in the X-API-Token header
MOVEMENT_WEBHOOK_URL=
MOVEMENT_API_TOKEN=

# Trading console (python -m src.console), both optional:
#   CONSOLE_MASTER_KEY    Fernet key for the credential vault (default: data/console/vault.key, DPAPI-protected on Windows)
#   CONSOLE_SECRET_KEY    session-signing key (default: data/console/session.key, created on first start)
CONSOLE_MASTER_KEY=
# AI assistant in the console (or store it encrypted on the Credentials page instead)
ANTHROPIC_API_KEY=
CONSOLE_SECRET_KEY=

# NIFTY 50 cash-equity service (python -m src.equity; tabs "Intraday cash" and "Swing" on the desk), optional:
#   EQUITY_WEBHOOK_URL   every alert is POSTed here as JSON when [ALERTS] webhook = true in config/equity.ini
# Live equity orders need LIVE_TRADING_CONFIRM above, `python -m src.equity --arm` each day, the LIVE switch on the
# dashboard and a confirmation per order. The Upstox keys / token above are shared; nothing else is needed.
EQUITY_WEBHOOK_URL=
